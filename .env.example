# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- NANTOR'S ELECTRONICS CONFIGURATION ---
# Firebase Configuration — use a dedicated staging project for Preview/local testing.
# Never copy production Firebase values into a Preview environment.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="YOUR_STAGING_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_STAGING_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STAGING_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Clé publique reCAPTCHA v3/Enterprise fournie par Firebase App Check (facultative en prévisualisation)
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Cloudinary Configuration (Upload non-signé pour les photos de produits)
VITE_CLOUDINARY_CLOUD_NAME="pgjikefb"
VITE_CLOUDINARY_UPLOAD_PRESET="nantors_products"
VITE_CLOUDINARY_ASSET_FOLDER="nantors-electronics/products"

# Contact & Ventes WhatsApp (Togo) : Remplacer obligatoirement par votre vrai numéro commercial (ex: 22890123456)
VITE_WHATSAPP_NUMBER="228_REMPLACEZ_PAR_VOTRE_NUMERO_COMMERCIAL"

